# Copy to `.env` and fill in. `.env` is gitignored.
#
# DD-2 (target chain) is UNRESOLVED. The endpoints below are candidates for
# fork testing, not a selected deployment target. Do not treat the presence of
# a URL here as a decision.

UNICHAIN_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

ETHERSCAN_API_KEY=

# Deployment key. Never commit a funded key; prefer a hardware wallet or
# `cast wallet` keystore over a raw private key in a file.
PRIVATE_KEY=
