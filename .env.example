# Copy to `.env` and fill in. `.env` is gitignored.
#
# DD-2 selected Base mainnet (2026-08-23). `BASE_RPC_URL` must point at a Base
# mainnet **archive** endpoint: PRD §15 scenario 10 (assumption A3) forks at
# historical heights and pulls whole historical blocks over `eth_getBlockByNumber`.
# Without it, `test/fork/A3PriorityOrdering.t.sol` skips and A3 stays unverified.
BASE_RPC_URL=

# Candidates for other fork work; not deployment targets.
UNICHAIN_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

ETHERSCAN_API_KEY=

# Deployment key. Never commit a funded key; prefer a hardware wallet or
# `cast wallet` keystore over a raw private key in a file.
PRIVATE_KEY=
