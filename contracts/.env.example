# Copy to `.env` and fill in. `.env` is gitignored.
#
# DD-2 selected Base mainnet (2026-08-23). `BASE_RPC_URL` must point at a Base
# mainnet **archive** endpoint: PRD §15 scenario 10 (assumption A3) forks at
# historical heights and pulls whole historical blocks over `eth_getBlockByNumber`.
# Without it, `test/fork/A3PriorityOrdering.t.sol` skips and A3 stays unverified.
BASE_RPC_URL=

# Candidates for other fork work; not deployment targets.
UNICHAIN_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

ETHERSCAN_API_KEY=

# Deployment key. Never commit a funded key; prefer a hardware wallet or
# `cast wallet` keystore over a raw private key in a file.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Deployment (script/Deploy.s.sol). Both phases must run under
# FOUNDRY_PROFILE=optimized: the dev profile compiles the hook to ~28KB, over
# EIP-170's 24,576-byte limit, so the deployment simply fails.
# ---------------------------------------------------------------------------

# Phase 1 output. Deploy BatchSolver first, then set this AND the matching
# `libraries` entry in foundry.toml, and recompile. The library address is
# embedded in the hook's creation bytecode, and the hook address is mined over
# that bytecode -- so a different library address means a different hook.
BATCH_SOLVER=

# Phase 2. The v4 singleton on the target chain.
POOL_MANAGER=
# Must sort: CURRENCY0 < CURRENCY1. Native ETH is address(0) and is always
# currency0 when present -- note the Slow Lane refuses it as INPUT.
CURRENCY0=
CURRENCY1=
TICK_SPACING=60
# Starting price, Q96. 79228162514264337593543950336 is 1:1.
START_SQRT_PRICE_X96=79228162514264337593543950336

# Which side is the chain's gas token: 0 neither, 1 currency0, 2 currency1.
# Selects the Fast-Lane tax mode and cannot be changed after deployment.
# 0 is always safe and selects the rate form.
GAS_TOKEN_SIDE=0

# Permanent parameter authority. NOT issued by anyone -- you choose it. An EOA
# (`cast wallet address --private-key $PRIVATE_KEY`) is fine for a testnet; use
# a Safe for anything holding real liquidity. It can never be address(0), and
# setting it to something you do not control freezes every tunable forever.
GOVERNANCE=

# Optional, but two defences are INACTIVE until set, and both are denominated
# in each currency's own token units, so there is no safe default:
#   - minimum Slow-Lane order size (the dust-spam floor)
#   - warehoused-exposure cap per direction
MIN_ORDER_SIZE0=
MIN_ORDER_SIZE1=
MAX_WAREHOUSE0=
MAX_WAREHOUSE1=
